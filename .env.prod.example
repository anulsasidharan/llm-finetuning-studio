# ═══════════════════════════════════════════════════════════════
# LLM FINE-TUNING STUDIO — Production Environment
# Copy to .env.prod and replace every CHANGE_ME value before
# running docker compose -f docker-compose.prod.yml up -d
# NEVER commit .env.prod to git
# ═══════════════════════════════════════════════════════════════

# ─── App ────────────────────────────────────────────────────────
APP_NAME="LLM Fine-Tuning Studio"
ENVIRONMENT=production
LOG_LEVEL=INFO
# Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fts_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=fts_db
DATABASE_URL=postgresql+asyncpg://fts_user:CHANGE_ME_strong_db_password@postgres:5432/fts_db
DATABASE_URL_SYNC=postgresql://fts_user:CHANGE_ME_strong_db_password@postgres:5432/fts_db

# ─── Redis ───────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_strong_redis_password@redis:6379/2
TRAINING_PUBSUB_DB=redis://:CHANGE_ME_strong_redis_password@redis:6379/3

# ─── Storage ─────────────────────────────────────────────────────
# Option A: MinIO (self-hosted — included in compose stack)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# Option B: AWS S3 (comment out MinIO block above; uncomment below)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Storage bucket names
BUCKET_DATASETS=fts-datasets
BUCKET_MODELS=fts-models
BUCKET_CHECKPOINTS=fts-checkpoints
BUCKET_EXPORTS=fts-exports

# S3 production bucket names (if using AWS S3)
# S3_BUCKET_DATASETS=fts-datasets-prod
# S3_BUCKET_MODELS=fts-models-prod
# S3_BUCKET_CHECKPOINTS=fts-checkpoints-prod
# S3_BUCKET_EXPORTS=fts-exports-prod

# ─── HuggingFace ────────────────────────────────────────────────
HF_TOKEN=hf_xxxx
HF_WRITE_TOKEN=hf_xxxx
HF_CACHE_DIR=/app/.cache/huggingface

# ─── Cloud GPU Vendors ──────────────────────────────────────────
RUNPOD_API_KEY=
LAMBDA_LABS_API_KEY=
CLOUD_AWS_ACCESS_KEY_ID=
CLOUD_AWS_SECRET_ACCESS_KEY=
CLOUD_GCP_SERVICE_ACCOUNT_JSON=
CLOUD_AZURE_SUBSCRIPTION_ID=
CLOUD_AZURE_CLIENT_ID=
CLOUD_AZURE_CLIENT_SECRET=
CLOUD_AZURE_TENANT_ID=

# ─── GPU Pricing ────────────────────────────────────────────────
GPU_PRICING_CACHE_TTL_SECONDS=3600

# ─── Notifications ──────────────────────────────────────────────
# Public-facing URL of this deployment (no trailing slash)
FRONTEND_URL=https://CHANGE_ME_your_domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@CHANGE_ME_your_domain.com
SLACK_WEBHOOK_URL=

# ─── Training Engine ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
TRAINING_CHECKPOINT_INTERVAL_STEPS=200
TRAINING_METRICS_PUSH_INTERVAL_SECONDS=5
TRAINING_ENGINE_REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/3
TRAINING_OUTPUT_DIR=/training_engine/output

# ─── Frontend (public vars — baked into the Next.js build) ──────
# These must match the public hostname before running: docker compose build
NEXT_PUBLIC_APP_NAME="LLM Fine-Tuning Studio"
NEXT_PUBLIC_API_URL=https://CHANGE_ME_your_domain.com
NEXT_PUBLIC_WS_URL=wss://CHANGE_ME_your_domain.com
